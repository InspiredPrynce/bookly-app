{
  "$description": "Bookly design tokens. W3C DTCG format. Color has two modes: light, dark.",
  "font": {
    "family": {
      "sans": { "$type": "fontFamily", "$value": ["Raleway", "Helvetica Neue", "Arial", "sans-serif"] },
      "mono": { "$type": "fontFamily", "$value": ["ui-monospace", "SF Mono", "Menlo", "Consolas", "monospace"] }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": 700 },
      "xbold": { "$type": "fontWeight", "$value": 800 }
    },
    "size": {
      "display": { "$type": "dimension", "$value": "56px" },
      "h1": { "$type": "dimension", "$value": "40px" },
      "h2": { "$type": "dimension", "$value": "32px" },
      "h3": { "$type": "dimension", "$value": "24px" },
      "h4": { "$type": "dimension", "$value": "20px" },
      "bodyLg": { "$type": "dimension", "$value": "18px" },
      "body": { "$type": "dimension", "$value": "16px" },
      "bodySm": { "$type": "dimension", "$value": "14px" },
      "caption": { "$type": "dimension", "$value": "12px" },
      "overline": { "$type": "dimension", "$value": "12px" }
    },
    "lineHeight": {
      "display": { "$type": "number", "$value": 1.07 },
      "heading": { "$type": "number", "$value": 1.2 },
      "body": { "$type": "number", "$value": 1.625 },
      "ui": { "$type": "number", "$value": 1.4 }
    },
    "letterSpacing": {
      "display": { "$type": "dimension", "$value": "-0.02em" },
      "heading": { "$type": "dimension", "$value": "-0.01em" },
      "body": { "$type": "dimension", "$value": "0em" },
      "overline": { "$type": "dimension", "$value": "0.14em" }
    },
    "features": {
      "$description": "Raleway defaults to old-style figures. lnum = lining, tnum = tabular.",
      "text": { "$value": "lnum" },
      "numeric": { "$value": "lnum, tnum" }
    }
  },
  "space": {
    "0": { "$type": "dimension", "$value": "0px" },
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "20px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "10": { "$type": "dimension", "$value": "40px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px" },
    "20": { "$type": "dimension", "$value": "80px" },
    "24": { "$type": "dimension", "$value": "96px" }
  },
  "radius": {
    "xs": { "$type": "dimension", "$value": "4px" },
    "sm": { "$type": "dimension", "$value": "8px" },
    "md": { "$type": "dimension", "$value": "12px" },
    "lg": { "$type": "dimension", "$value": "16px" },
    "xl": { "$type": "dimension", "$value": "24px" },
    "icon": { "$type": "dimension", "$value": "22.5%" },
    "full": { "$type": "dimension", "$value": "9999px" }
  },
  "border": {
    "width": {
      "default": { "$type": "dimension", "$value": "1px" },
      "strong": { "$type": "dimension", "$value": "2px" }
    }
  },
  "motion": {
    "duration": {
      "fast": { "$type": "duration", "$value": "120ms" },
      "base": { "$type": "duration", "$value": "200ms" },
      "slow": { "$type": "duration", "$value": "320ms" }
    },
    "easing": {
      "standard": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] },
      "enter": { "$type": "cubicBezier", "$value": [0, 0, 0, 1] },
      "exit": { "$type": "cubicBezier", "$value": [0.3, 0, 1, 1] }
    }
  },
  "layout": {
    "breakpoint": {
      "sm": { "$type": "dimension", "$value": "640px" },
      "md": { "$type": "dimension", "$value": "768px" },
      "lg": { "$type": "dimension", "$value": "1024px" },
      "xl": { "$type": "dimension", "$value": "1280px" }
    },
    "container": {
      "reading": { "$type": "dimension", "$value": "640px" },
      "app": { "$type": "dimension", "$value": "1152px" }
    },
    "tapMin": { "$type": "dimension", "$value": "44px" }
  },
  "z": { "base": 0, "sticky": 100, "overlay": 200, "modal": 300, "toast": 400 },
  "color": {
    "brand": {
      "ink": { "$type": "color", "$value": "#1B1714" },
      "paper": { "$type": "color", "$value": "#F4EEE3" },
      "oxblood": { "$type": "color", "$value": "#7A1F2B" }
    },
    "light": {
      "bg": { "$type": "color", "$value": "#F4EEE3" },
      "surface": { "$type": "color", "$value": "#FBF8F2" },
      "surfaceRaised": { "$type": "color", "$value": "#FFFFFF" },
      "surfaceSunken": { "$type": "color", "$value": "#EBE3D5" },
      "scrim": { "$type": "color", "$value": "#1B1714", "$extensions": { "alpha": 0.48 } },
      "text": { "$type": "color", "$value": "#1B1714" },
      "textSecondary": { "$type": "color", "$value": "#5C534A" },
      "textTertiary": { "$type": "color", "$value": "#6B6258" },
      "textDisabled": { "$type": "color", "$value": "#A89D8D" },
      "textOnAccent": { "$type": "color", "$value": "#FBF8F2" },
      "textLink": { "$type": "color", "$value": "#7A1F2B" },
      "border": { "$type": "color", "$value": "#D9CFBD" },
      "borderStrong": { "$type": "color", "$value": "#B9AD98" },
      "focusRing": { "$type": "color", "$value": "#7A1F2B" },
      "accent": { "$type": "color", "$value": "#7A1F2B" },
      "accentHover": { "$type": "color", "$value": "#651823" },
      "accentPressed": { "$type": "color", "$value": "#52121C" },
      "accentSubtle": { "$type": "color", "$value": "#EFDCD9" },
      "accentSubtleText": { "$type": "color", "$value": "#5A1520" },
      "success": { "$type": "color", "$value": "#2F6B4F" },
      "successSubtle": { "$type": "color", "$value": "#DCEBE2" },
      "warning": { "$type": "color", "$value": "#8A5A00" },
      "warningSubtle": { "$type": "color", "$value": "#F3E5C6" },
      "danger": { "$type": "color", "$value": "#C42B1C" },
      "dangerSubtle": { "$type": "color", "$value": "#F6D9D4" },
      "info": { "$type": "color", "$value": "#2C5A7A" },
      "infoSubtle": { "$type": "color", "$value": "#D9E6EE" },
      "aiSurface": { "$type": "color", "$value": "#EBE7F0" },
      "aiBorder": { "$type": "color", "$value": "#CFC7DA" },
      "aiText": { "$type": "color", "$value": "#3B2F4F" },
      "member1": { "$type": "color", "$value": "#B4741C" },
      "member2": { "$type": "color", "$value": "#1F7A74" },
      "member3": { "$type": "color", "$value": "#7A3F7E" },
      "member4": { "$type": "color", "$value": "#5B7A2A" },
      "member5": { "$type": "color", "$value": "#3F5F9A" },
      "member6": { "$type": "color", "$value": "#B4533A" }
    },
    "dark": {
      "bg": { "$type": "color", "$value": "#14110F" },
      "surface": { "$type": "color", "$value": "#1B1714" },
      "surfaceRaised": { "$type": "color", "$value": "#241F1B" },
      "surfaceSunken": { "$type": "color", "$value": "#0F0D0B" },
      "scrim": { "$type": "color", "$value": "#000000", "$extensions": { "alpha": 0.64 } },
      "text": { "$type": "color", "$value": "#F4EEE3" },
      "textSecondary": { "$type": "color", "$value": "#BDB2A3" },
      "textTertiary": { "$type": "color", "$value": "#968B7D" },
      "textDisabled": { "$type": "color", "$value": "#5E564C" },
      "textOnAccent": { "$type": "color", "$value": "#F4EEE3" },
      "textLink": { "$type": "color", "$value": "#DE7B85" },
      "border": { "$type": "color", "$value": "#2E2823" },
      "borderStrong": { "$type": "color", "$value": "#4A4239" },
      "focusRing": { "$type": "color", "$value": "#DE7B85" },
      "accent": { "$type": "color", "$value": "#B8434F" },
      "accentHover": { "$type": "color", "$value": "#C5525E" },
      "accentPressed": { "$type": "color", "$value": "#A63844" },
      "accentSubtle": { "$type": "color", "$value": "#3A1A1E" },
      "accentSubtleText": { "$type": "color", "$value": "#F0B4BA" },
      "success": { "$type": "color", "$value": "#6FBF98" },
      "successSubtle": { "$type": "color", "$value": "#17291F" },
      "warning": { "$type": "color", "$value": "#E0B04A" },
      "warningSubtle": { "$type": "color", "$value": "#2C2410" },
      "danger": { "$type": "color", "$value": "#F0786C" },
      "dangerSubtle": { "$type": "color", "$value": "#321815" },
      "info": { "$type": "color", "$value": "#7FB3D6" },
      "infoSubtle": { "$type": "color", "$value": "#132230" },
      "aiSurface": { "$type": "color", "$value": "#221D2B" },
      "aiBorder": { "$type": "color", "$value": "#3A3149" },
      "aiText": { "$type": "color", "$value": "#D8CDEA" },
      "member1": { "$type": "color", "$value": "#E0A04A" },
      "member2": { "$type": "color", "$value": "#55C4BB" },
      "member3": { "$type": "color", "$value": "#C58AC9" },
      "member4": { "$type": "color", "$value": "#9CC25A" },
      "member5": { "$type": "color", "$value": "#8AA8E6" },
      "member6": { "$type": "color", "$value": "#E68A72" }
    }
  },
  "elevation": {
    "light": {
      "1": { "$type": "shadow", "$value": { "color": "#1B171414", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" } },
      "2": { "$type": "shadow", "$value": { "color": "#1B17141A", "offsetX": "0px", "offsetY": "4px", "blur": "12px", "spread": "0px" } },
      "3": { "$type": "shadow", "$value": { "color": "#1B171424", "offsetX": "0px", "offsetY": "12px", "blur": "32px", "spread": "0px" } }
    },
    "dark": {
      "$description": "Dark depth = lighter surface + 1px border. Shadow is secondary.",
      "1": { "$type": "shadow", "$value": { "color": "#2E2823", "offsetX": "0px", "offsetY": "0px", "blur": "0px", "spread": "1px" } },
      "2": { "$type": "shadow", "$value": { "color": "#00000066", "offsetX": "0px", "offsetY": "4px", "blur": "12px", "spread": "0px" } },
      "3": { "$type": "shadow", "$value": { "color": "#0000008C", "offsetX": "0px", "offsetY": "12px", "blur": "32px", "spread": "0px" } }
    }
  }
}
