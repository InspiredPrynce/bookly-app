# ── Secrets — MUST stay excluded ─────────────────────────────────────
# Live credentials. Never commit.
supabase.txt
firebase.txt
gemini.txt
*.pem
*.p12

# ── Environment files ────────────────────────────────────────────────
# Real env files are per-machine. Only the example template is committed.
env/*.json
!env/dev.example.json

# ── Flutter / Dart ───────────────────────────────────────────────────
.dart_tool/
.packages
build/
.pub-cache/
.pub/
coverage/
*.g.dart
*.freezed.dart

# ── IDE / editor ─────────────────────────────────────────────────────
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.swp
*~

# ── OS junk ──────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Android signing ──────────────────────────────────────────────────
android/key.properties
android/app/*.jks
android/app/*.keystore
*.keystore
*.jks

# ── iOS ──────────────────────────────────────────────────────────────
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/ephemeral/
*.xcworkspace
!default.xcworkspace

# ── Firebase (generated) ─────────────────────────────────────────────
# Regenerated by `flutterfire configure`; contains no secret beyond
# the public API key shipped in the app bundle, but keeps diffs clean.
lib/firebase_options.dart

# ── Supabase local ───────────────────────────────────────────────────
supabase/.temp/
supabase/.branches/

# ── Executing-plans scratch workspace (git-ignored by design) ────────
.superpowers/

# ── Logs / scratch ───────────────────────────────────────────────────
*.log
*.tmp
