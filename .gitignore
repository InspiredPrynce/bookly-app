# ── Secrets — MUST stay excluded ─────────────────────────────────────
# Live credentials. Never commit.
supabase.txt
firebase.txt
gemini.txt
*.pem
*.p12

# ── Environment files ────────────────────────────────────────────────
# Real env files are per-machine. Only the example template is committed.
env/*.json
!env/dev.example.json

